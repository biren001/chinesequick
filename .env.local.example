# Cloudflare Pages 自动发布凭据（复制成 .env.local 后填真实值）
# .env.local 已在 .gitignore 里（规则 .env*.local），不会被提交。

# Account ID：Cloudflare 后台 → 右侧栏「Account ID」，32 位十六进制
CF_ACCOUNT_ID=your_account_id_here

# API Token：https://dash.cloudflare.com/profile/api-tokens → Create Custom Token
#   权限 Permission : Account → Cloudflare Pages → Edit
#   资源 Account Resources : Include → 只选这一个账户
#   资源 Zone Resources : 留空（不需要 DNS 权限）
CF_API_TOKEN=your_api_token_here

# Pages 项目名：后台 Pages 项目列表里的名字，大小写敏感
CF_PAGES_PROJECT=chinesequick

# 可选：只有在走代理才能访问 Cloudflare 的网络里才需要
# CF_PROXY=http://127.0.0.1:7890
